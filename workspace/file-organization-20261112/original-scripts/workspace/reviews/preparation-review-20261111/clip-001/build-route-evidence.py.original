from pathlib import Path
import hashlib
import json
import math
import subprocess
from PIL import Image

ROOT = Path.cwd()
WORK = ROOT / 'tmp/preparation-review-20261111/clip-001'
REF = ROOT / 'references/preparation-room-20261111'
PHOTOS = ROOT / 'apps/site/photos/preparation-room'
REF.mkdir(parents=True, exist_ok=True)
PHOTOS.mkdir(parents=True, exist_ok=True)
source = next(ROOT.rglob('20261111_135935*.mp4'))
sidecar = source.with_suffix('.txt')

def digest(path):
    h = hashlib.sha256()
    with path.open('rb') as f:
        for b in iter(lambda: f.read(1024 * 1024), b''):
            h.update(b)
    return h.hexdigest()

probe = json.loads(subprocess.check_output(['ffprobe', '-v', 'error', '-show_format', '-show_streams', '-of', 'json', str(source)], encoding='utf-8'))
(WORK / 'ffprobe.json').write_text(json.dumps(probe, ensure_ascii=False, indent=2), encoding='utf-8')
duration = float(probe['format']['duration'])
observations = []
for line in sidecar.read_text(encoding='utf-8-sig').splitlines():
    if line.startswith('{') and 'video_time_ms' in line:
        observations.append(json.loads(line))

def campus_point(lat, lon):
    north = (lat - 35.36269436) * 111320
    east = (lon - 129.03104166) * 111320 * math.cos(math.radians(35.36269436))
    return [round(north * math.cos(math.radians(b)) + east * math.sin(math.radians(b)), 3) for b in [325.4, 55.4]]

gps_samples = []
for sec in [0, 12, 24, 30, 36, 48, 60, 90, 120, 150, 180, 210, 240, 261, 510, 522]:
    row = min(observations, key=lambda o: abs(o['video_time_ms'] / 1000 - sec))
    g, c = row.get('geolocation', {}), row.get('camera_direction', {})
    sample = {'requestedSecond': sec, 'videoSecond': row['video_time_ms'] / 1000, 'status': g.get('status'), 'headingDegrees': c.get('heading_degrees'), 'pitchDegrees': c.get('pitch_degrees'), 'usedForObjectPlacement': False}
    if 'latitude_degrees' in g:
        sample.update({'latitude': g['latitude_degrees'], 'longitude': g['longitude_degrees'], 'horizontalAccuracyM': g.get('horizontal_accuracy_m'), 'ageMs': g.get('age_ms'), 'campusXZ': campus_point(g['latitude_degrees'], g['longitude_degrees'])})
    gps_samples.append(sample)

# Extraction is deterministic; preserve the original image content and rotation.
if not (WORK / 'native/frame-165.jpg').exists():
    subprocess.run(['ffmpeg', '-hide_banner', '-loglevel', 'error', '-ss', '165', '-i', str(source), '-frames:v', '1', '-q:v', '2', '-y', str(WORK / 'native/frame-165.jpg')], check=True)

