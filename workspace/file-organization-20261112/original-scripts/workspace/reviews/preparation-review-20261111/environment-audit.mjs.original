import assert from 'node:assert/strict';
import { readFile } from 'node:fs/promises';
import * as THREE from '../../apps/shared/vendor/three.module.js';
import { DRYER_BUILDING_FLOORS } from '../../apps/site/dryer-building-data.js';
import { buildDryerBuildingEnvironment } from '../../apps/site/dryer-building-envelope.js';
import { buildPreparationEnvironment } from '../../apps/site/preparation-environment.js';

const s = {
  scene: new THREE.Scene(), geometries: new Set(), materials: new Set(),
  _group(parent, position = [0, 0, 0]) { const value = new THREE.Group(); value.position.set(...position); parent.add(value); return value; },
  _material(color, roughness = .7, metalness = .1, extra = {}) { const value = new THREE.MeshStandardMaterial({ color, roughness, metalness, ...extra }); this.materials.add(value); return value; },
  _mesh(geometry, material, parent, position = [0, 0, 0]) { const value = new THREE.Mesh(geometry, material); value.position.set(...position); parent.add(value); return value; },
};
const spec = DRYER_BUILDING_FLOORS[1];
const environment = buildDryerBuildingEnvironment(s, { floor: 1, elevation: spec.elevation, spec });
const before = Object.fromEntries(Object.entries(environment).map(([key, root]) => [key, root.children.length]));
buildPreparationEnvironment(s, environment, spec);
const added = Object.values(environment).flatMap(root => root.children.filter(child => child.name.startsWith('preparation-')));
assert(added.length > 10);
s.scene.updateMatrixWorld(true);
const room = id => spec.rooms.find(entry => entry.id === id).bounds;
const toilet = environment.architectureFixtures.getObjectByName('preparation-washroom-visible-interior');
const toiletBounds = new THREE.Box3().setFromObject(toilet), toiletRoom = room('toilet');
assert(toiletBounds.min.x >= toiletRoom.minX && toiletBounds.max.x <= toiletRoom.maxX);
assert(toiletBounds.min.z >= toiletRoom.minZ && toiletBounds.max.z <= toiletRoom.maxZ);
const inner = environment.architectureFixtures.getObjectByName('preparation-inner-rapid-door-trim');
assert.deepEqual(inner.position.toArray(), [28.6, 0, 4.6]);
assert(Math.abs(inner.rotation.y - Math.PI / 2) < 1e-9);
assert.equal(environment.cover.children.length, before.cover, 'office ceiling must not cover the top/perspective cutaway');
const lockers = environment.architectureFixtures.getObjectByName('preparation-under-existing-stair-lockers');
const lockerBounds = new THREE.Box3().setFromObject(lockers);
const existingStair = environment.architectureFixtures.getObjectByName('dryer-building-1-southeast-stair');
existingStair.traverse(node => {
  if (node.isMesh) assert(!new THREE.Box3().setFromObject(node).intersectsBox(lockerBounds), 'locker bank intersects existing stair treads');
});

// Trace actual opaque architecture at eye height, including full facade walls.
const opaque = [];
for (const key of ['facade', 'structure', 'architectureFixtures']) environment[key].traverse(node => {
  if (node.isMesh && !(node.material.transparent && node.material.opacity < .99)) opaque.push(node);
});
const routeSegments = [
  ['exterior raw door', [35, 1.4, .6], [32, 1.4, .6]],
  ['daily / weighing gap', [27.5, 1.4, .8], [29, 1.4, .8]],
  ['second orange shutter', [28.6, 1.4, 3.9], [28.6, 1.4, 5.3]],
  ['air shower / entry sightline', [27.6, 1.4, 17.6], [33.7, 1.4, 17.6]],
  ['washroom side door', [33.85, 1.4, 15.2], [32.5, 1.4, 15.2]],
  ['entry to north corridor', [33.85, 1.4, 17.6], [33.85, 1.4, 12.5]],
  ['double glass entry', [34.8, 1.4, 17.6], [33.7, 1.4, 17.6]],
  ['office glazed front', [26.6, 1.4, 18], [26.6, 1.4, 18.8]],
  ['CIP front', [23.3, 1.4, 18], [23.3, 1.4, 19]],
];
for (const [name, start, end] of routeSegments) {
  const origin = new THREE.Vector3(...start); origin.y += spec.elevation;
  const target = new THREE.Vector3(...end); target.y += spec.elevation;
  const delta = target.clone().sub(origin), ray = new THREE.Raycaster(origin, delta.clone().normalize(), .001, delta.length());
  const hits = ray.intersectObjects(opaque, false);
  assert.equal(hits.length, 0, `${name} blocked by ${hits.map(hit => hit.object.parent.name).join(', ')}`);
}
const customDoors = [];
environment.architectureFixtures.traverse(node => { if (node.userData.customArchitecturalDoor) customDoors.push(node); });
assert(customDoors.length >= 9);
for (const door of customDoors.filter(node => !node.userData.doorId.startsWith('raw-'))) {
  const size = new THREE.Box3().setFromObject(door).getSize(new THREE.Vector3());
  assert(size.y >= 2.1, `${door.name} full-height frame missing from architecture fixtures`);
}

// Exercise the real scene visibility method without starting a renderer.
const source = await readFile(new URL('../../apps/site/scene.js', import.meta.url), 'utf8');
const marker = '  _visibility() {';
let body = source.slice(source.indexOf(marker) + marker.length, source.indexOf('  zoomBy(factor, pointer = null)')).trim();
assert(body.endsWith('}')); body = body.slice(0, -1);
const visibility = new Function('THREE', body);
const state = {
  ...s, equipment: [], objects: new Map(), locationDisks: new Map(), activeFloor: 1, view: 'top', isolated: false,
  structureEnabled: true, ductsEnabled: true, floorDecks: new Map([[1, environment.deck]]), floorStructures: new Map([[1, environment.structure]]),
  buildingEnvironments: new Map([[1, environment]]), upperEnvironments: new Map(), packagingEnvironments: new Map(),
  outdoor: { ducts: new THREE.Group() }, campus: { ducts: new THREE.Group() }, survey: new THREE.Group(),
  _applyPackagingDisplayOffsets() {}, _updatePersonCamera() {}, _invalidate() {}, getPackagingLevel() { return 'all'; },
};
for (const view of ['top', 'perspective', 'aisle', 'person']) {
  state.view = view; visibility.call(state, THREE);
  assert.equal(environment.facade.visible, ['aisle', 'person'].includes(view));
  assert.equal(environment.architectureFixtures.visible, true);
}
state.structureEnabled = false; visibility.call(state, THREE);
assert.equal(environment.architectureFixtures.visible, false); assert.equal(environment.facade.visible, false);
state.structureEnabled = true; state.ductsEnabled = false; visibility.call(state, THREE);
assert.equal(environment.ducts.visible, false);
for (const floor of [2, 'campus']) {
  state.activeFloor = floor; visibility.call(state, THREE);
  for (const root of Object.values(environment)) assert.equal(root.visible, false);
}
state.activeFloor = 1; state.isolated = true; visibility.call(state, THREE);
for (const root of Object.values(environment)) assert.equal(root.visible, false);
let meshes = 0;
for (const root of added) root.traverse(node => { if (node.isMesh) { meshes++; for (const value of node.matrixWorld.elements) assert(Number.isFinite(value)); } });
console.log(JSON.stringify({ checks: 'full architectural door rays, current room bounds, floor1 guard, real scene visibility', routeSegments: routeSegments.length, preparationMeshes: meshes, toiletRoom, toiletBounds: { min: toiletBounds.min.toArray(), max: toiletBounds.max.toArray() } }));
