from pathlib import Path
import hashlib, json, math, subprocess
from PIL import Image

root = Path.cwd()
source = next(root.rglob('20261111_133538*.mp4'))
metadata = source.with_suffix('.txt')
review = root / 'tmp/boiler-review-20261111/clip-001'
native = review / 'native'
native.mkdir(parents=True, exist_ok=True)
assets = root / 'apps/site/photos/boiler-room'
assets.mkdir(parents=True, exist_ok=True)
reference = root / 'references/boiler-room-20261111'
reference.mkdir(parents=True, exist_ok=True)
rows = []
for line in metadata.read_text(encoding='utf-8-sig').splitlines():
    try:
        row = json.loads(line)
    except json.JSONDecodeError:
        continue
    if isinstance(row, dict) and 'geolocation' in row and 'video_time_ms' in row:
        rows.append(row)

def sha(path):
    return hashlib.file_digest(path.open('rb'), 'sha256').hexdigest()

def gps(t):
    row = min(rows, key=lambda r: abs(r['video_time_ms'] / 1000 - t))
    g, direction = row['geolocation'], row.get('camera_direction', {})
    if g.get('status') != 'valid':
        return {'status': g.get('status')}
    e = (g['longitude_degrees'] - 129.03104166) * 111320 * math.cos(math.radians(35.36269436))
    n = (g['latitude_degrees'] - 35.36269436) * 111320
    bearing = math.radians(325.4)
    return {'videoTimeSeconds': row['video_time_ms'] / 1000,
        'positionXZ': [round(e * math.sin(bearing) + n * math.cos(bearing), 3), round(e * math.cos(bearing) - n * math.sin(bearing), 3)],
        'latitude': g['latitude_degrees'], 'longitude': g['longitude_degrees'],
        'horizontalAccuracyMetres': g.get('horizontal_accuracy_m'), 'ageMs': g.get('age_ms'),
        'headingDegrees': direction.get('heading_degrees'), 'pitchDegrees': direction.get('pitch_degrees'),
        'role': 'camera estimate, never equipment/door survey'}

observations = {
16: '건조실 측면 지대가온실 크림색 양개문·콘크리트 차양, 바닥 황흑 보호대.',
24: '주황 고속문 옆 벽 제어함과 빨간 회전등.',
36: '큰 노란 수직 가스관과 은색 플랜지·수동 핸드휠. 가스관 보호용 황흑 난간.',
48: '넓은 회색 셔터 바로 오른쪽 보일러실 돌출 문패와 구멍 뚫린 크림색 출입문. 건조실 저층 별동 측면에 붙어 있음.',
50: '출입문 표찰 원문: 1팀 2파트 보일러실 (3ton/h 노통연관, 1.5ton/h 관류형 각 1대). 관리 담당자의 연락처는 모델 텍스트로 복제하지 않음.',
64: '초록 방류벽 안 스테인리스 탱크와 왼쪽 콘크리트 외부 계단. 계단 위치는 탱크 서쪽·공무환경팀실 동쪽 사이 구역 판단 근거.',
76: '탱크 옆 제품별 연결 호스·상부 여러 배관·수직 라벨 가대와 외부 접속함.',
100: '건조실 뒷벽의 생산 2팀 휴게실 유리문·옆 천공 양개문·공통 콘크리트 차양·벽 에어컨.',
106: '유리문 위 문패 생산 2팀 휴게실. 바로 옆 천공문은 전기실로 확정할 수 있는 문패가 보이지 않음.',
110: '휴게실 옆 천공 양개문·옆 자재 입구 문구. 이 문을 전기실 내부로 단정하지 않음.',
120: '열린 회색 양개문 안 초록 바닥·부품 수납장·공구 선반·호스 릴. 출입문에 공무작업장 표찰.',
122: '노란 표찰 원문 공무작업장. 공무환경팀실이라는 별도 사용자 지정 사무실 명칭과 혼동하지 않음.',
128: '초록 철망 출입문에 수변전실 표찰: 수전설비용량 2,100kW / 22,900V, 비상발전설비 160kW. 바로 뒤 콘크리트 외부 계단과 옹벽.',
160: '건조실 뒤 낮은 창·루버 아래 다리 달린 스테인리스 사각 용기/세척부와 벽의 배기 덕트. 정확한 설비 용도 미확정.',
168: '뒤쪽 통로 바닥 근처 은색 보온 배관 여러 줄과 검정 단열 엘보·지지대.',
176: '스테인리스 용기와 노란 보온 마감 접속부 근접. 용량·내용물·가동 상태는 미확인.',
178: 'LPG 용기 바로 뒤 작은 크림색 콘크리트 건물·짧은 처마·문·외부 철제 계단·옥상 전기 가대/애자. 사용자 확인 공무환경팀실 외관 근거.',
180: 'LPG 쪽 작은 건물과 건조실 사이 도로 위를 가로지르는 두 줄의 은색 높은 배관 가대. 오른쪽에 건조실 저층 외벽.',
}
photos = []
for seconds, observation in observations.items():
    full = native / f'frame-{seconds}.jpg'
    if not full.exists():
        subprocess.run(['ffmpeg', '-v', 'error', '-y', '-ss', str(seconds), '-i', str(source), '-frames:v', '1', '-q:v', '2', str(full)], check=True)
    out = assets / f'clip-001-{seconds:03d}s.jpg'
    image = Image.open(full)
    image.thumbnail((1440, 1440), Image.Resampling.LANCZOS)
    image.save(out, quality=84, optimize=True)
    photos.append({'seconds': seconds, 'source': source.relative_to(root).as_posix(),
        'native': full.relative_to(root).as_posix(), 'asset': out.relative_to(root).as_posix(),
        'sha256': sha(out), 'bytes': out.stat().st_size, 'dimensions': list(image.size),
        'observation': observation, 'cameraEstimate': gps(seconds)})

