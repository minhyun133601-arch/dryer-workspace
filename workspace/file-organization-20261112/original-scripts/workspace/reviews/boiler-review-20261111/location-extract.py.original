path = reference / 'location-evidence.json'
path.write_text(json.dumps(evidence, ensure_ascii=False, indent=2) + '\n', encoding='utf-8')
print(json.dumps({'evidence': str(path.relative_to(root)), 'photos': len(photos), 'bytes': sum(x['bytes'] for x in photos)}, ensure_ascii=True))
