photos = []
for sec, caption in photo_specs:
    src = WORK / f'native/frame-{sec}.jpg'
    target = PHOTOS / f'clip-001-{sec:03d}s.jpg'
    im = Image.open(src).convert('RGB')
    im.thumbnail((1440, 1440), Image.Resampling.LANCZOS)
    im.save(target, quality=84, optimize=True)
    photos.append({'path': target.relative_to(ROOT).as_posix(), 'videoSecond': sec, 'caption': caption, 'sourceFrame': src.relative_to(ROOT).as_posix(), 'sha256': digest(target), 'width': im.width, 'height': im.height, 'reviewed': True})

plan_left = WORK / 'plan-sequence/frame-07.jpg'
target = PHOTOS / 'clip-001-075p2s-plan.jpg'
im = Image.open(plan_left).convert('RGB')
im.thumbnail((1440, 1440), Image.Resampling.LANCZOS)
im.save(target, quality=84, optimize=True)
photos.append({'path': target.relative_to(ROOT).as_posix(), 'videoSecondApprox': 75.2, 'caption': '현장 조명 배치도 왼쪽: 원료창고 두 구역·메인판넬·카제인 포함 탱크열', 'sourceFrame': plan_left.relative_to(ROOT).as_posix(), 'sha256': digest(target), 'width': im.width, 'height': im.height, 'reviewed': True})

# A rectified overview aids geometric reading. It does not add pixels or labels.
overview = Image.open(WORK / 'plan-sequence/frame-04.jpg').convert('RGB')
overview = overview.transform((1120, 1000), Image.Transform.QUAD, (324, 680, 320, 1141, 850, 1196, 886, 716), Image.Resampling.BICUBIC)
overview.save(WORK / 'plan-overview-rectified.png')
Image.open(plan_left).crop((175, 240, 1080, 1190)).save(WORK / 'plan-left-labels.png')
Image.open(WORK / 'native/frame-76.jpg').crop((0, 390, 755, 1310)).save(WORK / 'plan-right-labels.png')

def zone(id, name, bounds, basis, seconds, note=''):
    x0, x1, z0, z1 = bounds
    return {'id': id, 'name': name, 'rawA013Bounds': {'minX': x0, 'maxX': x1, 'minZ': z0, 'maxZ': z1}, 'local1FBounds': {'minX': round(x0 - 8.6, 3), 'maxX': round(x1 - 8.6, 3), 'minZ': round(z0 - 13.4, 3), 'maxZ': round(z1 - 13.4, 3)}, 'basis': basis, 'sourceSeconds': seconds, 'dimensionsMeasuredOnSite': False, 'note': note}

